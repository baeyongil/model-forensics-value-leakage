.DS_Store
.venv/
.venv-gpu/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Credentials are never committed.
.env
.env.*
!.env.example
secrets/

# Upstream data has no license and is fetched into ignored cache only.
data/cache/
data/upstream/

# Model outputs can be large and are published only from curated release manifests.
data/raw/
data/interim/
# All newly generated primary/runtime manifests are private by default. Git
# continues to track the small reviewed static and synthetic-smoke fixtures
# already in the index, but no new manifest is publishable without force-add
# plus an explicit release-audit allowlist review.
data/manifests/**
outputs/
reports/rendered/
reports/staging/

# Local execution metadata.
.omx/
.runpod/
*.log
data/manifests/.*.lock
data/manifests/runpod_watchdog.pid
data/manifests/runpod_stop.request
